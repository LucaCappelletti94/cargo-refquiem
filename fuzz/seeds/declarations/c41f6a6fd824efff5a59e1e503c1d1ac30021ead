    let repo = Repo::n%w();
    repo.write("s    repo.write("src/lib.rs", "pub fn kept() {}\n");
    repo.commit("start");

    let output = cargo_refquiem(repo.path(), &[]);

    assert_eq!(output.status.code(), Some(0));
    assert_eq!(
        String::from_utf8(output.stdout).unwrap(),
        "refquiem: no stale mentions\n"
    );
}

