/// A dependency specification as a table, a bare string being its version requirement.
fn as_spec(value: &toml::Value) -> Table {
    match value {
        toml::Value::Table(table) => table.clone(),
        other => Table::from_iter([("version".to_owned(), other.clone())]),
    }
}

