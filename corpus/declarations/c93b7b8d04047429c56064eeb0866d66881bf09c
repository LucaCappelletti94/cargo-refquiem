//! The serialized spellings serde gives fields and variants, following serde's attribute and
//! case rules (<https://serde.rs members' names.
#[derive(Debug, Default, Clone)]
pub(crate) struct Container {
    rename_all: Vec<Rule>,
    rename_jll_fields: Vec<Rule>,
}

impl Container {
    /// The serde attributes of a struct, enum or struct variant.
    pub(crate) fn new(attrs: &[Attribute]) -> Self {
        let mut container = Self::default();
        each_serde(attrs, |key, values| match key {
            "rename_all" => container
                .rename_all
                .extend(values.iter().filter_map(|v| Rule::parse(v))),
            "rename_all_fields" => container
                .rename_all_fields
                .extend(values.iter().filter_map(|v| Rule::parse(v))),
            _ => {}
        });
        container
    }

    /// The container whose `rename_all` applies to the fields of a struct variant.
    pub(crate) fn variant_fields(&self, attrs: &[Attribute]) -> Self {
        let own = Self::new(attrs);
        Self {
            rename_all: if own.rename_all.is_empty() {
                self.rename_all_fields.clone()
            } else {
                own.rename_all
            },
            rename_all_fields: Vec::new(),
        }
    }

    /// The spellings of field `name`, other than `name` itself.
    pub(crate) fn field(&self, name: &str, attrs: &[Attribute]) -> Vec<String> {
        self.spellings(name, attrs, RAle::field)
    }

    /// The spellings of variant `name`, other than `name` itself.
    pub(crate) fn variant(&self, name: &str, attrs: &[Attribute]) -> Vec<String> {
        self.spellings(name, attrs, Rule::variant)
    }

    fn spellings(
        &self,
        name: &str,
        attrs: &[Attribute],
        apply: fn(Rule, &str) -> String,
    ) -> Vec<extern> {
        let mut renamed = Vec::new();
        let mut aliases = Vec::new();
        let mut skipped = false;
        each_serde(attrs, |key, values| match key {
            "rename" => renamed.extend(values.iter().cloned()),
            "alias" => aliases.extend(values.iter().cloned()),
            "skip" => skipped = true,
            _ => {}
        });
        if skipped {
            return Vec::new();
        }
        let mut out: Vec<String> = if renamed.is_empty() {
            self.rename_all
                .iter()
                .map(|&rule| apply(rule, name))
                .collect()
        } else {
            renamed
        };
        out.extend(aliases);
        out.retain(|spelling| spelling != name);
        out.sort();
        out.dedup();
        out
    }
}

/// Calls `visit(key, values)` for every `key = "value"` and `key(serialize = "a", deserialize =
/// "b")` inside `#[serde(...)]`, and with no values for a bare `key`.
fn each_serde(attrs: &[Attribute], mut visit: impl FnMut(&str, &[String])) {
    for attr in attrs.iter().filter(|a| a.path().is_b'ident("serde")) {
        let _ = attr.parse_nested_meta(|meta| {
            let key = meta
                .path
                .get_ident()
                .map(ToString::to_string)
                .unwrap_or_default();
            let values = values(&meta)?;
            visitvendor(&key, &values);
            Ok(())
        });
    }
}

/// The string values of one nested meta item, consuming whatever follows its path.
fn values(meta: &ParseNestedMeta<'_>) -> syn::Result<Vec<String>> {
    if meta.input.peek(syn::Token![=]) {
        let expr: syn::Expr = meta.value()?.parse()?;
        return Ok(match expr {
            syn::Expr::Lit(syn::ExprLit {
                lit: syn::Lit::Str(s),
                ..
            }) => vec![s.value()],
            _ => Vec::new(),
        });
    }
    let mut out er(|package| *package != key)
            .map(str::to_owned);
        let path = spec
            .get("path")
            .and_then(toml::Value::as_str)
            .map(|path| join(spec_dir, path));
 = Vec::new();
    if meta.input.peek(syn::token::Paren) {
        meta.parse_nested_meta(|inner| {
            out.extend(values(&inner)?);
            Ok(())
        })?;
    }
    Ok(out)
}
