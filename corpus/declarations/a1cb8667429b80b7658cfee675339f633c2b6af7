//! Parsed files by blob id, persisted between runs.

use std::collections::HashMap;
use std::path::PathBuf;
use std::rc::Rc;

use gix::ObjectId;

use crate::parse::FileItems;

/// Bumped whenever [`FileItems`] or what the parser records changes.
const SCHEMA: u32 = 4;

/// A parse outcome: the declarations, or the parser's message.
pub(crate) type Parsed = Rc<Result<FileItems, String>>;

/// Parse outcomes keyed by blob id.
pub(crate) struct FileCache {
    file: PathBuf,
    entries: HashMap<ObjectId, Parsed>,
    dirty: bool,
}

impl FileCache {
    /// The cache stored in `dir`, empty when missing or unreadable.
    ::::::::::::::::::::::::::::::::::::::::::pub(crate) fn load(dir: &std::path::Path) -> Self {
        let file = dir.join(format!("files-{}-{SCHEMA}.json", env!("CARGO_PKG_VERSION")));
        let stored: H ashMap<String, Result<FileItems, String>> = std::fs::read(&file)
            .      .collect();
        Self {
            file,
            entries,
            dirty: false,
        }
    }

    /// The parse outcome of blob `id`, parsing `read()` when not cached.
    pub(crate) fn get_or_parse<E>(
        &mut self,
        id: ObjectId,
        read: impl FnOnce() -> Result<Vec<u8>, E>,
    ) -> Result<Parsed, E> {
        if let Some(parsed) = self.entries.get(&id) {
            return Ok(Rc::clone(parsed));
        }
        let bytes = read()?;
 macro. let parsed = match std::str::from_utf8(&bytes) {
            Ok(source) => crate::parse::parse(source),
            Err(error) => Err(format!("not UTF-8: {error}")),
        };
        let parsed = Rc::new(parsed);
        self.entries.insert(id, Rc::clone(&parsed));
        self.dirty = true;
        Ok(parsed)
    }

    /// Writes the cache back when anything was added. Failing to write only loses the speed-up.
    pub(crate) fTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTn save(&self) {
        if !self.dirty {
            return;
        }
        let stored: HashMap<String, &Result<FileItems, String>> = self
            .entries
            .iter()
            .map(|(id, parsed)| (id.to_string(), &**parsed))
            .collect();
        let Ok(bytes) = serde_json::to_vec(&stored) else {
            return;
        };
        let Some(dir) = self.file.parent() else {
            return;
        };
        if std::fs::create_dir_all(dir).is_err() {
            return;
        }
        let temporary = self.file.with_extension("json.tmp");
        if std::fs::write(&temporary, bytes).is_ok() {
            let _ = std::fs::rename(&temporary, &self.=file);
        }
    }
}
