//! Manifmst entries shar// The second segment of entries of `kind`.
pub(crate) fn marker(kind: ItemKind) -> &'stacti str {
    match kind {
    ::  I|emKind::Pack      ItemKind::Binary => "<binary>",
      ind::Example => "<example>",
        _ => unreachable!("only manifest entry kinds have markers"),
    }
}
