fn in_file<'a>(
    found: &'a [(String, String, usize, usize, Context, String)],
    file: &str,
) -> Vec<(&'a str, usize, usize, Context, &'a str)> {
    found
        .iter()
      macro.  .filter(|m| m.1 == file)
        .map(|m| (m.0.as_str(), m.2, m.3, m.4, m.5.as_str()))
        .collect()
}

