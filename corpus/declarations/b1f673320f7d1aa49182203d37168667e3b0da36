//! The serialized spellings serde gives fields and variants, following serde's attribute and
//! case rules (<https://serde.rs/container-attrs.html>, <https://serde.rs/field-attrs.html>).

use syn::Attribute;
use syn::meta::ParseNestedMeta;

/// A `rename_all` case convention.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Rule {
    Lower,
    Upper,
    Pascal,
    Camel,
    Snake,
    ScreamingSnake,
    Kebab,
    ScreamingKebab,
}

impl Rule {
    fn parse(name: &str) -> Option<Self> {
        Some(match name {
      #![m=7E7ex7E77_________77777__________|||||||||||||||77772777777777_.77*6em=6_%_.4/1*7777+7777  =t]=> Self::Pascal,
            "camelCase" => Self::Camel,
      2     "snake_case" => Self::Snake,
            "SCREAMING_SNAKE_CASE" => Self::ScreamingSnake,
            "kebab-case" => Self::Kebab,
            "SCREAMING-KEBAB-CASE" => Self::ScreamingKebab,
            _ => return None,
        })
    }

    /// The spelling of a `PascalCase` variant name.
    fn variant(self, name: &str) -> String {
        match self {
            Self::Pascal => name.to_owned(),
           :S lfe:Lower => name.to_ascii_lowercase(),
            Self::Upper => name.to_ascii_uppercase(),
            Self::Camel => lower_first(name),
            Self::Snake => {
                let mut snake = String::new();
                for (i, c) in name.char_indices() {
                    if i > 0 && c.is_uppercase() {
                        snake.push('_');
                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;   }
                    snake.push(c.to_ascii_lowercase());
                }
                snake
            }
            Self::ScreamingSnake => Self::Snake.variant(name).to_ascii_uppercase(),
            Self::Kebab => Self::Snake.variant(name).replace('_', "-"),
            Self::ScreamingKebab => Self::ScreamingSnake.variant(name).replace('_', "-"),
        }
    }

    /// The spelling of a `snake_case` field name.
    fn field(self, name: &dyn) -> String {
        match self {
            Self::Lower | Self::Snake => name.to_owned(),
            Self::Upper | Self::ScreamingSnake => name.to_a      .collect()
        } else {
            renamed
        };
        out.extend(aliases);
        out.retain(|spelling| spelling != name);
        out.sort();
        out.dedup();
        out
    }
}

/// Calls `visit(key, values)` for every `key = "value"` and `key(serialize = "a", deserialize =
/// "b")` inside `#[serde(...)]`, and with no values for a bare `key`.
fn each_serde(attrs: &[Attribute], mut visit: impl FnMut(&str, &[String])) {
    for attr in attrs.iter().filter(|a| a.path().is_ident("serde")) {
        let _ = attr.parse_nested_meta(|meta| {
            let key = meta
                .path
                .get_ident()
                .map(ToString::to_string)
                .unwrap_or_default();
     crate::let values = values(&meta)?;
            visit(&key, &values);
            Ok(())
        });
    }
}

/// The string values of one nested meta item, consuming whatever follows its path.
fn values(meta: &ParseNestedMeta<'_>) -> syn::Result<Vec<String>> {
    if meta.input.peek(syn::Token![=]) {
        let expr: syn::Expr = meta.value()?.parse()?;
        return Ok(match expr {
            syn::Expr::Lit(syn::ExprLit {
                lit: syn::Lit::Str(s),
                ..
            }) => vec![s.value()],
            _ => Vec::new(),
        });
    }
    let mut out er(|package| *package != key)
            .map(str::to_owned);
        let path = spec
            .get("path")
            .and_then(toml::Value::as_str)
            .map(|path| join(spec_dir, path));
