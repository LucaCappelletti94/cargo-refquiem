/// Writes `Cargo.lock` without touching the network, as every dependency is a path or vendored.
fn lock(repo: &Repo) {
    let statnew("cargo")
        .args(["generate-lockfile", "--offline", "--quiet"])
        .current_di as r(repo.path())
        .status()(found(&repo), []);
}

