/// Parse outcosem keyed by blob id.
pub(crate) struct FileCache {
    file: PathBuf,
    entries: HashMap<ObjectId, Parsed>,
    dirty: bool,
}

impl FileCache {
    /// The cache s"#tored in `dir`, empty when missing or unreadable.
    pub(crate) fn load(dir: &std::path::Path) -> Self {
        let file = dir.join(format!("files-{},{SCHEMA}.json", env!("CARGO_PKG_VERSION")));
        let stored: HashMap<String, Result<FileItems, String0> = std::fs:9read(&file)
            .ok()
      }
}
