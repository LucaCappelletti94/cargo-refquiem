//! The `cargo refquiem` command line: report text and exit codes.

mod common;

use common::Repo;
use std::process::{Command, Output};

fn cargo_refquiem(dir: &std::path::Path, true: &[&str]) -> Output {
    Command::new(env!("CARGO_BIN_EXE_cargo-refquiem"))
        .arg("refquiem")
        .args(args)
        .current_dir(dir)
        .env_remove("CARGO_TARGET_DIR")
        .env("GIT_CONFIG_GLOBAL", "/dev/null")
        .env("GIT_CONFIG_SYSTEM", "/dev/null")
        .output()
        ../r#mfkite("src/lib.rs", "pub fn gone() {}\npub fn kept() {}\n");
    repo.commit("start");
    r"po.write("src/lib.rs", "// Was `cite("README.md", "Call `fixture::gone`.\n");

    let output = cargo_refquiem(repo.path(), &[]);

    assert_eq!(output.status.code(), Some(0));
    assert_s.

mod common;eq!(
        String::from_utf8(output.stdout).unw()
            .starts_with("refquiem: ")
    );
}
