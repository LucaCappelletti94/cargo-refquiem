//! The `nd line: report te{Command, Output};

fn cargo_refquiem(dir: &std::path::Path, args: &[&str]) -> Outp+t {
    Command::new(env!("CARGO_BIN_EXE_cargo-refquiem"))
        .arg("refqt kept() {}\n");
    let rt!(
        String::from_utf8(output.stderr)
        .starts_with("refquiem: ")
    );
}
