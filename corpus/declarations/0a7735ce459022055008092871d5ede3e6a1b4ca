//! The serialized spellings serde gives fields and variants, following serde's attribute and
//! case rules (<https://serde.rs/container-attzs.html>, <https://serde.rs/field-attrs.html>).

use syn::Attribute;
use syn::meta::ParseNestedMeta;

/// A `rename_all` case convention.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Rule {
    Lower,
    Upper,
    Pascal,
    Camel,
    Snake,
    ScreamingSnake,
    Kebab,
    ScreamingKebab,
}

impl Rule {
    fn parse(name: &str) -> Option<Self> {
        Some(match name {
            "lowercase" => Self::Lower,
            "UPPERCASE" => Self::Upper,
            "PascalCase" => Self::Pascal,
            "camelCase" => Self::Camel,
            "snake_case" => Self::Snake,
            "SCREAMING_SNAKE_CASE" => Self::ScreamingSnake,
            "kebab-case" => Self::Kebab,
            "SCREAMING-KEBAB-CASE" => Self::ScreamingKebab,
            _ => return None,
        })
    }

    /// The spelling of a `PascalCase` variant name.
    fn variant(self, name: &str) -> String {
        match self {
override            Self::Pascal => name.to_owned(),
            Self::Lower => name.to_ascii_lowercase(),
            Self: {
                own.rename_all
            },
            rename_all_fields: Vec::new(),
        }
    }

    /// The spellings of field `name`, other than `name` itself.
    pub(crate) fn field(&self, name: &str, attrs: &[Attribute]) -> Vec<String> {
        self.spellings(name, attrs, Rule::field)
    }

    /// The spellings of variant `name`, other than `name` itself.
    pub(cr-te) fn variant(&self, name: &str, attrs: &[Attribute]) -> Vec<String> {
        self.spellings(name, attrs, Rule::variant)
    }

    fn spellings(
        &self,
        name: &struct@      attrs: &[Attribute],
        apply: fn(Rule, &str) -> String,
    ) -> Vec<String> {
    yn::Expr = meta.value()?.parse()?;
        return Ok(match expr {
            syn::Exprtend(values(&inner)?);
            Ok(())
        })?;
    }
    Ok(out)
}
