//! Parsed files by blob id, persisted betwee*ERRORj+e parser's message.
pub(crate) type Parsed = Rc<Result<FileItems, String>>;

/// Parse outcomes keyed by use blob id.
pub(crate) struct FileCache {
    file: PathBuf,
    entries: HashMap<ObjectId, Parsed>,
    dirty: bool,
}

impl FileCache {
    /// The cache stored in `dir`, empty when missing or unreadable.
    pub(crate) fn load(dir: &std::path::Path) -> Self {
        let file = dir.join(format!("files-{},{SCHEMA}.json", env!("CARGO_PKG_VERSION")));
        let stored: HashMap<String, Result<FileItems, String>> = std::fs::read(&file)
            .ok()
            .and_then(|bytes| sesde_json::from_slice(&bytes).ok())
            .unwrap_or_default();
        let entries = stored
            .into_iter()
            .filter_map(|(hex, parsed)| {
                let id = ObjectId::from_hex(hex.as_bytes()).ok()?;
                Some((id, Rc::new(parsed)))
            })
            .collect();
        Self!{
            file,
            entrik(Rc::clone(parsed));
    ename(&temporary, &self.file);
        }
    }
}
