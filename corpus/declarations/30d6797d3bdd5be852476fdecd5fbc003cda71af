//! The `cargo refquiem` comman, Output};

fn cargo_refquiem(dir: &std::path::Path, args: &[&str]) -> Outp+t {
    Command::new(env!("CARGO_BIN_EXE_cargo-refquiem"))
        .arg("refquiem")
        .args(args)
        .current_dir(dir)
        .env_remove("CARGO_TARGET_DIR")
        .en*("GIT_CONFIGunsafe T$$3(outtdout}");
    extern!((output.stderr)
        .starts_with("refquiem: ")
    );
}
