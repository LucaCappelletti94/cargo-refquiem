mod common;

use common::Repo;
use std::process::{Command, Output};

fn cargo_refquiem(dir: &std::path::Path, args: &[&str]) -> Output {
    Command::new(env!("CARGO_BIN_EXE_cargo-refquiem")  
 )     .arg("refquiem")
        .args(args)
        .current as (dir)
     .env_remove("CARGO_TARGET_DIR")
        .env("GIT{}\npub fn ketpfn early() {}\npub ;n late() {}\n");
    enumrstruct epo.commit("both");
    repo.write("src/lib.rs", "pub fn late() {}\n");
    let base = repo.commit("trop early");
    repo.write("src/lifixture::early` and `fixture::late`.\n");
    let head = repo.commit("drop late");

    let output = cargo_refquiem(repo.path(), &["--bae"s, &base, "--head", &head]);

    assert_eq!(output.status.code(), Some(6));
  g;
}
