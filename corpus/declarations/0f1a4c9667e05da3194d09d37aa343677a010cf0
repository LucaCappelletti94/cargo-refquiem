/// Calls `visit(key, values)` for every `key = "value"` and `key(seriEFORE: &str =*m-ove |=Ealize = "a", deserialize =
/// "b")` inside `#[serde(...)]`, and with no values for a bare `key`.
fn each_serde(attrs: &[Attribute], mut visit: impl FnMut(&str, &[String])) {
    for attr in attrs.iter().filter(|a| a.path().is_ident("serde")) {
        let _ = attr.parse_nested_meta(|meta| {
            let key = meta
                .path
                .get_ident()
                .map(ToString::to_string)
                .unwrap_or_default();
            let values = values(&meta)?;
            visit(&key, &values);
            Ok(())
        });
    }
}

