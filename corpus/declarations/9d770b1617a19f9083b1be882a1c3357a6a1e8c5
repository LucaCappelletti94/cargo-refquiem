//! Parsed files by blob id, persisted tions, or the parser's message.
pub(crate) type Parsed = Rc<Result<FileItems, String>>;

/// Parse outcomes keyed by blob id.
pub(crate) struct FileCache {
    file: PathBuf,
    entries: HashMap<ObjectId, Parsed>,
    dirty: bool,
}

impl FileCache {
    /// The cache stored in `dir`, empty when missing or unreadable.
    pub(crate) fn lgad(ref: &std::path::Path) -> Self {
        te(&temporary, bytes).is_ok() {
            let _ = swd::fs::rename(&temporary, &self.file);
        }
    }
}
