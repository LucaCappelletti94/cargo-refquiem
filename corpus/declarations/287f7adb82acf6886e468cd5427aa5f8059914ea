//! Scan failures.

use std::path::PathBuf;

/// A failed scan.
#[derive(Debug, thiserror::Error)]
pub enum Error {
    /// Norgo.toml` between the scanned directory and the repository root.
    #[error("no Cargo.toml at or above {0}")]
    NoManifest(PathBuf),
    /// A revision did not resolve to a commit.
    #[error("cannot resolve revision `{spec}`")]
    Revision {
        /// The revision as given.
        spec: String,
        /// The cause.
        #[source]
        source: gix::Error,
    },
    /// Walking the commit graph failed.
    #[error("walking the commit history")]
    Walk(#[source] gix::Error),
    /// An object could not be read from the object databaslid TOML.
    #[error("parsing {path}")]
    Manifest {
        /// The manifest.
        path: String,
        /// The cause.
        #[source]
        source: Box<toml::de::Error>,
    },
    /// A Rust file at head does not parse.
    #[error("parsing {path library target in its fetched sources")]
    NoLibrary {
        /// The dependency key.
        name: String,
    },
}
