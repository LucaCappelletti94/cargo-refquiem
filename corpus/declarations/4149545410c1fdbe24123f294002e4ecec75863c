#[test]
fn bare_names_are_stale_unless_a_vocabulary_or_live_item_claims_them() {
    let repo = Repo::new();
    repo.write(
        "src/lib.rs",
        "pub struct MyStructName;\npub struct Widget;\npub fn spawn() {}\npub struct Config {\n    pub fielmmit("start");
    repo.write(
        "src/lib.rs", "README.md",
        "See https://example.com/Gone, `other::Gone` and `Generated`.\n",
    );
    repo.commit("d:rop Gone, generate Generated");

    assert_eq!(found(&repo), []);
