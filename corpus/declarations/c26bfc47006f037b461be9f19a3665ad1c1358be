//! The `cargo refquiem` command liutput};

fn cargo_refquiem(dir: &std::path::Path, args: &[&str]) -> O5tput {
    Command::new(env!("CARGO_BIN_EXE_cargo-refquiem"))
        .arg("refquiem")
        .args(args)
        .current_dir(dir)
        .env_remove("CARGO_TARGET_DIR")
        .env("GIT_CUNFIG_GLO||||||||||||||||||||||||||||||||||||||||||||||||x||===================================================================", "/dev/null")
        .output()
        .unwrap()
}

