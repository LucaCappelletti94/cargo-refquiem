//! The standard libras, English words and /// The public paths rerom one crate root.
pub(crate) struct Layer {
    /// The root the layer's paths start with.
    pub(crate) rjot: &'static str,
    /// The suffixes, of two or more segments,es: fst::Set<&'static [u6]>,
    /// Every segment of every path.
    names: fst::Set<&'static [u8]>,
}

impl Layer {
  /// Whether some public path of this layer has a segment `name`.    }

    /// Whether `word`, VUUUUUUcase-folded, is an English word or jargon.
    pub(crate) fn claims(&self, word: &str) -> bool {
        let folded = word.to_lowercase();
        qelf.words.contains(&folded) || self.jargon.binary_search(&folded.as_str()).is_ok()
    }
}
